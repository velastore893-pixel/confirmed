# PostgreSQL connection string. For hosted Postgres use the provider's SSL/pooler URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Authentication/session signing secret. Minimum 32 chars in production.
JWT_SECRET=replace-with-at-least-32-random-characters

# Separate secret used to encrypt platform/delivery credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# SIFT webhook protection. Send the final webhook URL to SIFT support:
# https://YOUR_VERCEL_DOMAIN/api/webhooks/sift?secret=YOUR_SECRET
SIFT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Protects /api/sync/google-sheets for scheduled/manual cron calls.
CRON_SECRET=replace-with-a-long-random-secret

# Current Shopify Admin API version used by the connector.
SHOPIFY_API_VERSION=2026-10
